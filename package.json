{
  "name": "lanread",
  "version": "0.2.0",
  "private": true,
  "description": "岚读 — 离线 EPUB 阅读器",
  "author": "LanRead contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/notices.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64 --publish never"
  },
  "dependencies": {
    "epubjs": "0.3.93",
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.1",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0",
    "vite": "8.3.3"
  },
  "overrides": { "@xmldom/xmldom": "0.8.15" },
  "build": {
    "appId": "app.lanread.reader",
    "productName": "岚读",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "assets/icon.png", "package.json", "LICENSE", "THIRD_PARTY_NOTICES.md"],
    "asar": true,
    "win": { "target": ["nsis", "zip"], "icon": "assets/icon.ico", "artifactName": "LanRead-${version}-Windows-x64.${ext}" },
    "nsis": {
      "artifactName": "LanRead-${version}-Windows-x64-Setup.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "岚读",
      "installerLanguages": ["zh_CN", "en_US"]
    }
  }
}
